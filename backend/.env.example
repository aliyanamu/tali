# Privy (Tier 2 wallet management — non-custodial)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Mantle mainnet RPC (Alchemy or public https://rpc.mantle.xyz)
MANTLE_ALCHEMY_RPC=
# Mantle testnet (Sepolia) — when set, starts RPC poll loop for local dev.
# Omit in production (Goldsky Mirror handles mainnet events).
MANTLE_TESTNET_RPC=https://rpc.sepolia.mantle.xyz
POLL_INTERVAL_MS=5000

# Solana RPC (optional)
SOLANA_HELIUS_RPC=
SOLANA_ALCHEMY_RPC=
BYREAL_KEYS_DIR=

# Goldsky Mirror — server reads only GOLDSKY_WEBHOOK_SECRET.
# GOLDSKY_PROJECT_ID and GOLDSKY_API_TOKEN are for the goldsky CLI, not the server.
GOLDSKY_WEBHOOK_SECRET=
GOLDSKY_PROJECT_ID=
GOLDSKY_API_TOKEN=

# LLM
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# CoinGecko (optional — free tier works without a key)
COINGECKO_API_KEY=

# Postgres
DATABASE_URL=postgresql://localhost:5432/tali_dev?sslmode=disable

# Mantle chain config
MANTLE_CHAIN_ID=5000

# Agent server wallet — signs setRule() and attestExecution() on behalf of Tali
# Generate with: cast wallet new
# AGENT_PRIVATE_KEY: 0x-prefixed 32-byte hex — never commit the real value
# AGENT_WALLET_ADDRESS: EVM address of the above key — fund with testnet MNT for gas
AGENT_PRIVATE_KEY=
AGENT_WALLET_ADDRESS=
AGENT_ERC8004_ID=1

# Deployed contracts (fill after deploy)
AUTONOMOUS_RULE_CONTRACT=
ERC8004_NFT_CONTRACT=

# Seed user (pnpm db:seed — keeps real credentials out of git)
SEED_USER_EMAIL=demo@example.com
SEED_USER_WALLET_ADDRESS=0x0000000000000000000000000000000000000001
SEED_USER_PRIVY_ID=privy_user_placeholder
SEED_USER_WALLET_ID=privy_wallet_placeholder

# Server (defaults shown)
PORT=8000
LOG_LEVEL=info
NODE_ENV=development
