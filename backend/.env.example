# Privy (Tier 2 wallet management — non-custodial)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Alchemy (Mantle RPC for state reads + ERC-8004 attestation)
ALCHEMY_API_KEY=
ALCHEMY_MANTLE_RPC=https://mantle-mainnet.g.alchemy.com/v2/

# byreal-cli (server-side agent wallet for DeFi execution on Solana)
ALCHEMY_SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=
BYREAL_KEYS_DIR=/home/deploy/.config/byreal/keys

# Goldsky (event delivery via webhook HMAC)
GOLDSKY_WEBHOOK_SECRET=

# LLM (provider-agnostic — set LLM_PROVIDER to anthropic | openai | google)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# CoinGecko Demo (price data)
COINGECKO_API_KEY=

# Postgres
DATABASE_URL=postgresql://localhost:5432/tali_dev

# Mantle chain config
MANTLE_CHAIN_ID=5000
AUTONOMOUS_RULE_CONTRACT=
ERC8004_NFT_CONTRACT=

# Server (defaults shown — override as needed)
PORT=3000
LOG_LEVEL=info
NODE_ENV=development
