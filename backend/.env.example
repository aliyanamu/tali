# Privy (Tier 2 wallet management — non-custodial)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Mantle RPC (use public endpoint or Alchemy)
MANTLE_ALCHEMY_RPC=https://rpc.sepolia.mantle.xyz

# Solana RPC (Helius mainnet preferred; Alchemy devnet as fallback)
SOLANA_HELIUS_RPC=https://mainnet.helius-rpc.com/?api-key=
SOLANA_ALCHEMY_RPC=https://solana-devnet.g.alchemy.com/v2/
BYREAL_KEYS_DIR=/home/deploy/.config/byreal/keys

# Alchemy Notify (webhook HMAC + address management)
ALCHEMY_WEBHOOK_SECRET=       # Signing Key — Alchemy dashboard → Data → Webhooks → Signing Key
ALCHEMY_WEBHOOK_AUTH_TOKEN=   # Auth token — Alchemy dashboard → Data → Webhooks → AUTH TOKEN button
ALCHEMY_WEBHOOK_ID=           # Webhook ID — Alchemy dashboard → Data → Webhooks → Webhook ID (e.g. wh_r95...)

# LLM (provider-agnostic — set LLM_PROVIDER to anthropic | openai | google)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# CoinGecko Demo (price data — optional, omit for free tier)
COINGECKO_API_KEY=

# Postgres
DATABASE_URL=postgresql://localhost:5432/tali_dev?sslmode=disable

# Mantle chain config
MANTLE_CHAIN_ID=5000
AUTONOMOUS_RULE_CONTRACT=
ERC8004_NFT_CONTRACT=

# Server (defaults shown — override as needed)
PORT=8000
LOG_LEVEL=info
NODE_ENV=development
