# Privy (Tier 2 wallet management — non-custodial)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Mantle RPC (use public endpoint or Alchemy)
MANTLE_ALCHEMY_RPC=https://rpc.sepolia.mantle.xyz

# Solana RPC (Helius mainnet preferred; Alchemy devnet as fallback)
SOLANA_HELIUS_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY_HERE
SOLANA_ALCHEMY_RPC=https://solana-devnet.g.alchemy.com/v2/
BYREAL_KEYS_DIR=/home/deploy/.config/byreal/keys

# Goldsky Mirror (raw secret header — NOT HMAC; set via: goldsky secret create)
GOLDSKY_WEBHOOK_SECRET=

# LLM (provider-agnostic — set LLM_PROVIDER to anthropic | openai | google)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# CoinGecko Demo (price data — optional, omit for free tier)
COINGECKO_API_KEY=

# Postgres
DATABASE_URL=postgresql://localhost:5432/tali_dev?sslmode=disable

# Mantle chain config
MANTLE_CHAIN_ID=5000
AUTONOMOUS_RULE_CONTRACT=
ERC8004_NFT_CONTRACT=

# Seed user (used by pnpm db:seed — keeps real credentials out of git)
SEED_USER_EMAIL=demo@example.com
SEED_USER_WALLET_ADDRESS=0x0000000000000000000000000000000000000001
SEED_USER_PRIVY_ID=privy_user_placeholder
SEED_USER_WALLET_ID=privy_wallet_placeholder

# Server (defaults shown — override as needed)
PORT=8000
LOG_LEVEL=info
NODE_ENV=development
