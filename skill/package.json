{
  "name": "@tali/skill",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.2",
    "@privy-io/server-auth": "^1.18.4",
    "drizzle-orm": "^0.36.0",
    "grammy": "^1.30.0",
    "hono": "^4.6.5",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "viem": "^2.21.25",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "drizzle-kit": "^0.28.0",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
